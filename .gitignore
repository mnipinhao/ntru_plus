/ntruplus-ntt-Optimized/avx2-bench/results/

# Release archives and raw benchmark logs are reproducible artifacts. Keep
# source, scripts, and curated JSON/Markdown summaries in the mainline.
/ntruplus-GT-Production/Additional_Implementation/*.zip
/ntruplus-GT-Production/Additional_Implementation/aarch64/benchmark/results/**/raw/

# Independent upstream checkout used for source and benchmark comparisons.
# Its exact revision and update procedure are recorded in third_party/README.md.
/third_party/NTTRU/
/third_party/NTRU_Prime_truncation/

# Build output directories (Slothy runs, benchmark builds) are never sources.
**/build/
