ntruplus-ntt-Optimized/artifacts/
.DS_Store
__pycache__/
*.pyc

# Codex agent skills are local development configuration, not repository
# source or release content.
/.agents/skills/

# Design notes, historical audits, and presentation material are maintained
# locally and are not part of the public repository.
/docs/

# Experiment records and generated candidates are local-only. Production and
# published feature branches contain only the promoted source and tests.
/experiments/

# Reproducible benchmark and solver output. Keep source, contracts, summaries,
# and generated assembly in git; regenerate raw logs when needed.
ntruplus-ntt-Optimized/Additional_Implementation/aarch64/NTRU+768/experiments/**/*.log
ntruplus-ntt-Optimized/Additional_Implementation/aarch64/NTRU+768/experiments/**/slothy.exit
ntruplus-ntt-Optimized/aarch64-bench/results/*.out
ntruplus-ntt-Optimized/aarch64-bench/results/*.log
ntruplus-ntt-Optimized/aarch64-bench/results/**/*.out
ntruplus-ntt-Optimized/aarch64-bench/results/**/*.log
ntruplus-ntt-Optimized/aarch64-bench/results/**/raw/
ntruplus-ntt-Optimized/aarch64-bench/results/**/bin/
ntruplus-ntt-Optimized/aarch64-bench/results/**/build.log
ntruplus-ntt-Optimized/aarch64-bench/results/**/*.map
ntruplus-ntt-Optimized/aarch64-bench/results/**/*.nm*.txt

# Local AVX2 benchmark output. Keep benchmark source and curated summaries on
# the AVX2 development branch.
/ntruplus-ntt-Optimized/avx2-bench/results/

# Release archives and raw benchmark logs are reproducible artifacts. Keep
# source, scripts, and curated JSON/Markdown summaries in the mainline.
/ntruplus-GT-Production/Additional_Implementation/*.zip
/ntruplus-GT-Production/Additional_Implementation/aarch64/benchmark/results/**/raw/

# Independent upstream checkout used for source and benchmark comparisons.
# Its exact revision and update procedure are recorded in third_party/README.md.
/third_party/NTTRU/
/third_party/NTRU_Prime_truncation/
