# main ignores /experiments/ (production carries only promoted source and
# tests); this development branch is where the experiment records live, so it
# tracks them.

# Reproducible benchmark and solver output. Keep source, contracts, summaries,
# and generated assembly in git; regenerate raw logs when needed.
ntruplus-ntt-Optimized/Additional_Implementation/aarch64/NTRU+768/experiments/**/*.log
ntruplus-ntt-Optimized/Additional_Implementation/aarch64/NTRU+768/experiments/**/slothy.exit
