# Simple Makefile for NTRU+ Profiling
# This is the WORKING version that actually compiles and runs

CC = gcc
CFLAGS = -O3 -march=native -Wall -Wextra -std=c99
INCLUDES = -Intruplus-KpqC-Final/Optimized_Implementation/NTRU+768 \
           -Intruplus-KpqC-Final/Optimized_Implementation/NTRU+768/fips202
LDFLAGS = -lm

# NTRU+ source files
NTRU_SOURCES = ntruplus-KpqC-Final/Optimized_Implementation/NTRU+768/kem.c \
               ntruplus-KpqC-Final/Optimized_Implementation/NTRU+768/poly.c \
               ntruplus-KpqC-Final/Optimized_Implementation/NTRU+768/ntt.c \
               ntruplus-KpqC-Final/Optimized_Implementation/NTRU+768/symmetric.c \
               ntruplus-KpqC-Final/Optimized_Implementation/NTRU+768/randombytes.c \
               ntruplus-KpqC-Final/Optimized_Implementation/NTRU+768/fips202/fips202.c

# Targets
profiler: working_profiler.c
	$(CC) $(CFLAGS) $(INCLUDES) working_profiler.c $(NTRU_SOURCES) -o profiler $(LDFLAGS)

run: profiler
	./profiler

clean:
	rm -f profiler *.o

.PHONY: run clean