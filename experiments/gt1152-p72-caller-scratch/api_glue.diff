@@ -30,11 +33,22 @@
 
 void poly_invntt_ternary(poly *out, const poly *in)
 {
+    /* The transform cannot run in place: every invntt16 call scatters its
+     * output across ranges the other calls still have to read, so the scratch
+     * is structural.  It is declared here rather than inside the assembly so
+     * that secure_clear() below actually reaches it -- the assembly allocates
+     * no hidden memory, which is how mlkem-native's kernels are arranged. */
+    /* 64-byte aligned: the library clear picks a wider strategy when the
+     * buffer is cache-line aligned, and `poly` only guarantees 16. */
+    _Alignas(64) poly scratch;
+
     invntt_ternary_asm(out->coeffs, in->coeffs,
                        &invntt9_constants_lane[0][0][0][0],
                        &invntt16_constants[0][0],
                        &invntt16_main_constants[0][0],
-                       &invntt16_tail_constants[0][0]);
+                       &invntt16_tail_constants[0][0],
+                       scratch.coeffs);
+    asm_wipe_2304(&scratch);
 }
 
