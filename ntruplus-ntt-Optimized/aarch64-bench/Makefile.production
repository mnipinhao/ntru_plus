# Minimal reproducible GT-production versus KPQC-final benchmark build.
# Keep experiment targets in the main Makefile; this file owns only the selected
# production KEM and its generic/component profiler closure.

.DEFAULT_GOAL := all

TARGET ?= bench-production
CC ?= gcc
RM ?= rm -f

VARIANT ?= gt_production_default
BENCH_MODE ?= kem_enc
USE_SHAKE_ASM ?= 0
NTESTS ?= 31
NITERATIONS ?= 2000
NWARMUP ?= 100
EXTRA_CFLAGS ?=
GT_PRODUCTION_LINK_ORDER ?= current

KEM_MODES = kem_keygen kem_enc kem_dec kem_components kernel_components
ifeq ($(filter $(BENCH_MODE),$(KEM_MODES)),)
$(error unknown BENCH_MODE=$(BENCH_MODE); supported modes: $(KEM_MODES))
endif

NTRUPLUS ?= ntruplus
KPQC_FINAL_ROOT ?= ../../ntruplus-KpqC-Final/Additional_Implementation/aarch64/NTRU+768
ifeq ($(VARIANT),gt_production_keygen_cq)
GT_PRODUCTION_KEYGEN_LAYOUT := cq
endif
GT_SOURCE_ROOT = $(NTRUPLUS)
include $(NTRUPLUS)/gt_production_sources.mk
include $(NTRUPLUS)/gt_production_variants.mk

ifeq ($(GT_PRODUCTION_KEYGEN_LAYOUT),cq)
GT_SELECTED_NTT_SOURCES = $(GT_PRODUCTION_KEYGEN_CQ_NTT_SOURCES)
GT_SELECTED_KEYGEN_SOURCES = $(GT_PRODUCTION_KEYGEN_CQ_RUNTIME_SOURCES)
else
GT_SELECTED_NTT_SOURCES = $(GT_PRODUCTION_NTT_SOURCES)
GT_SELECTED_KEYGEN_SOURCES = $(GT_PRODUCTION_BPQ_CQ_KEYGEN_RUNTIME_SOURCES)
endif

GT_NTT_ASM = $(word 1,$(GT_SELECTED_NTT_SOURCES))
GT_INVNTT_ASM = $(GT_PRODUCTION_INVNTT_SOURCE)
GT_INVNTT_RMINUS1_ASM = $(GT_PRODUCTION_INVNTT_RMINUS1_SOURCE)
GT_BASEINV_BATCH_C = \
	$(NTRUPLUS)/poly_gt_baseinv_batch.c \
	$(GT_PRODUCTION_BASEINV_TREE_SOURCE) \
	$(GT_PRODUCTION_BASEINV_FINISH_SOURCE) \
	$(GT_PRODUCTION_BASEINV_FQINV_SOURCE)
GT_BASE_ASM = $(GT_PRODUCTION_BASE_SOURCES)
GT_PRODUCTION_RMINUS1_SOURCE_OVERRIDE ?=
ifeq ($(strip $(GT_PRODUCTION_RMINUS1_SOURCE_OVERRIDE)),)
GT_SELECTED_RMINUS1_SOURCE = $(word 4,$(GT_BASE_ASM))
else
GT_SELECTED_RMINUS1_SOURCE = $(GT_PRODUCTION_RMINUS1_SOURCE_OVERRIDE)
endif
GT_KEYGEN_ALL_CQ_SOURCE = \
	$(NTRUPLUS)/experiments/keygen_all_cq/keygen_all_cq.c
GT_DIRECT_BPQ_ENDPOINT_SOURCE = \
	$(NTRUPLUS)/asm/gt/experiment/forward_ntt/poly_ntt_to_bpq_endpoint.S
GT_DIRECT_CQ_ENDPOINT_SOURCE = \
	$(NTRUPLUS)/asm/gt/experiment/forward_ntt/poly_ntt_to_cq_endpoint.S
GT_SHARED_CORE_DIRECT_CQ_SOURCE = \
	$(NTRUPLUS)/asm/gt/experiment/forward_ntt/poly_ntt_shared_core_direct_cq.S

FULL_KEM_MODES = kem_keygen kem_enc kem_dec
ifneq ($(filter $(BENCH_MODE),$(FULL_KEM_MODES)),)
BENCH_HARNESS = bench_kem_runtime.c
else
BENCH_HARNESS = bench.c
endif
BENCH_SOURCES = hal/hal.c $(BENCH_HARNESS)

GT_KEM_CORE = \
	$(NTRUPLUS)/randombytes.c \
	$(NTRUPLUS)/kem.c \
	$(NTRUPLUS)/symmetric.c
KPQC_KEM_CORE = \
	$(KPQC_FINAL_ROOT)/randombytes.c \
	$(KPQC_FINAL_ROOT)/kem.c \
	$(KPQC_FINAL_ROOT)/symmetric.c
KPQC_KEM_SOURCES = \
	$(KPQC_FINAL_ROOT)/poly.c \
	$(KPQC_FINAL_ROOT)/asm/add.s \
	$(KPQC_FINAL_ROOT)/asm/crepmod3.s \
	$(KPQC_FINAL_ROOT)/asm/pack.s \
	$(KPQC_FINAL_ROOT)/asm/cbd.s \
	$(KPQC_FINAL_ROOT)/asm/ntt.s \
	$(KPQC_FINAL_ROOT)/asm/base.s

ifneq ($(filter $(BENCH_MODE),kem_components kernel_components),)
GT_SELECTED_SUPPORT_SOURCES = $(GT_PRODUCTION_GENERIC_SUPPORT_SOURCES)
GT_REFERENCE_NTT_SOURCE = $(NTRUPLUS)/ntt.c
else
GT_SELECTED_SUPPORT_SOURCES = $(GT_PRODUCTION_KEM_SUPPORT_SOURCES)
GT_REFERENCE_NTT_SOURCE =
endif

GT_KEM_SOURCES_CURRENT = \
	$(GT_REFERENCE_NTT_SOURCE) \
	$(GT_PRODUCTION_DECAP_CANONICAL_POINTWISE_SOURCES) \
	$(GT_SELECTED_SUPPORT_SOURCES) \
	$(GT_NTT_ASM) \
	$(GT_SELECTED_KEYGEN_SOURCES) \
	$(GT_INVNTT_RMINUS1_ASM) \
	$(GT_SELECTED_RMINUS1_SOURCE) \
	$(GT_PRODUCTION_Q31_ENCAP_SOURCE)

ifeq ($(BENCH_MODE),kem_keygen)
GT_KEM_SOURCES_MODE_HOT = \
	$(GT_REFERENCE_NTT_SOURCE) \
	$(GT_SELECTED_SUPPORT_SOURCES) \
	$(GT_NTT_ASM) \
	$(GT_SELECTED_KEYGEN_SOURCES) \
	$(GT_PRODUCTION_Q31_ENCAP_SOURCE) \
	$(GT_SELECTED_RMINUS1_SOURCE) \
	$(GT_INVNTT_RMINUS1_ASM) \
	$(GT_PRODUCTION_DECAP_CANONICAL_POINTWISE_SOURCES)
else ifeq ($(BENCH_MODE),kem_enc)
GT_KEM_SOURCES_MODE_HOT = \
	$(GT_REFERENCE_NTT_SOURCE) \
	$(GT_SELECTED_SUPPORT_SOURCES) \
	$(GT_NTT_ASM) \
	$(GT_PRODUCTION_Q31_ENCAP_SOURCE) \
	$(GT_SELECTED_KEYGEN_SOURCES) \
	$(GT_SELECTED_RMINUS1_SOURCE) \
	$(GT_INVNTT_RMINUS1_ASM) \
	$(GT_PRODUCTION_DECAP_CANONICAL_POINTWISE_SOURCES)
else ifeq ($(BENCH_MODE),kem_dec)
GT_KEM_SOURCES_MODE_HOT = \
	$(GT_REFERENCE_NTT_SOURCE) \
	$(GT_SELECTED_SUPPORT_SOURCES) \
	$(GT_SELECTED_RMINUS1_SOURCE) \
	$(GT_INVNTT_RMINUS1_ASM) \
	$(GT_NTT_ASM) \
	$(GT_PRODUCTION_DECAP_CANONICAL_POINTWISE_SOURCES) \
	$(GT_PRODUCTION_Q31_ENCAP_SOURCE) \
	$(GT_SELECTED_KEYGEN_SOURCES)
else
GT_KEM_SOURCES_MODE_HOT = $(GT_KEM_SOURCES_CURRENT)
endif

ifeq ($(GT_PRODUCTION_LINK_ORDER),current)
GT_KEM_SOURCES = $(GT_KEM_SOURCES_CURRENT)
else ifeq ($(GT_PRODUCTION_LINK_ORDER),mode_hot)
GT_KEM_SOURCES = $(GT_KEM_SOURCES_MODE_HOT)
else
$(error unknown GT_PRODUCTION_LINK_ORDER=$(GT_PRODUCTION_LINK_ORDER); use current or mode_hot)
endif

ifneq ($(filter $(BENCH_MODE),kem_components kernel_components),)
GT_KEM_SOURCES += \
	$(GT_INVNTT_ASM) \
	$(filter-out $(GT_PRODUCTION_BASEINV_FQINV_SOURCE),$(GT_BASEINV_BATCH_C)) \
	$(filter-out $(word 4,$(GT_BASE_ASM)),$(GT_BASE_ASM))
GT_COMPONENT_FLAGS = $(GT_PRODUCTION_GENERIC_API_FLAGS)
else
GT_COMPONENT_FLAGS =
endif

ifeq ($(VARIANT),gt_production_default)
SCHEME_ROOT = $(NTRUPLUS)
SOURCES = $(BENCH_SOURCES) $(GT_KEM_CORE) $(GT_KEM_SOURCES)
VARIANT_FLAGS = \
	$(GT_PRODUCTION_DEFAULT_FLAGS) \
	$(GT_COMPONENT_FLAGS) \
		-DGT_PRODUCTION_VARIANT_NAME=\"gt_production_default\" \
		-DBENCH_VARIANT_GT=1
else ifeq ($(VARIANT),gt_production_keygen_cq)
SCHEME_ROOT = $(NTRUPLUS)
SOURCES = $(BENCH_SOURCES) $(GT_KEM_CORE) $(GT_KEM_SOURCES)
VARIANT_FLAGS = \
	$(GT_PRODUCTION_DEFAULT_FLAGS) \
	$(GT_COMPONENT_FLAGS) \
	-DGT_PRODUCTION_VARIANT_NAME=\"gt_production_keygen_cq\" \
	-DBENCH_VARIANT_GT=1
else ifeq ($(VARIANT),gt_keygen_all_cq)
SCHEME_ROOT = $(NTRUPLUS)
SOURCES = $(BENCH_SOURCES) $(GT_KEM_CORE) $(GT_KEM_SOURCES) \
	$(GT_KEYGEN_ALL_CQ_SOURCE)
VARIANT_FLAGS = \
	$(GT_PRODUCTION_DEFAULT_FLAGS) \
	$(GT_COMPONENT_FLAGS) \
	-DGT_EXPERIMENT_USE_KEYGEN_ALL_CQ \
	-DGT_PRODUCTION_VARIANT_NAME=\"gt_keygen_all_cq\" \
	-DBENCH_VARIANT_GT=1 \
	-ffunction-sections \
	-fdata-sections \
	-Wl,--gc-sections
else ifeq ($(VARIANT),gt_keygen_all_cq_direct_bpq)
SCHEME_ROOT = $(NTRUPLUS)
SOURCES = $(BENCH_SOURCES) $(GT_KEM_CORE) $(GT_KEM_SOURCES) \
	$(GT_KEYGEN_ALL_CQ_SOURCE) $(GT_DIRECT_BPQ_ENDPOINT_SOURCE)
VARIANT_FLAGS = \
	$(GT_PRODUCTION_DEFAULT_FLAGS) \
	$(GT_COMPONENT_FLAGS) \
	-DGT_EXPERIMENT_USE_KEYGEN_ALL_CQ \
	-DGT_EXPERIMENT_USE_KEYGEN_DIRECT_BPQ_ENDPOINT \
	-DGT_PRODUCTION_VARIANT_NAME=\"gt_keygen_all_cq_direct_bpq\" \
	-DBENCH_VARIANT_GT=1 \
	-ffunction-sections \
	-fdata-sections \
	-Wl,--gc-sections
else ifeq ($(VARIANT),gt_keygen_all_cq_direct_cq)
SCHEME_ROOT = $(NTRUPLUS)
SOURCES = $(BENCH_SOURCES) $(GT_KEM_CORE) $(GT_KEM_SOURCES) \
	$(GT_KEYGEN_ALL_CQ_SOURCE) $(GT_DIRECT_CQ_ENDPOINT_SOURCE)
VARIANT_FLAGS = \
	$(GT_PRODUCTION_DEFAULT_FLAGS) \
	$(GT_COMPONENT_FLAGS) \
	-DGT_EXPERIMENT_USE_KEYGEN_ALL_CQ \
	-DGT_EXPERIMENT_USE_KEYGEN_DIRECT_CQ_ENDPOINT \
	-DGT_PRODUCTION_VARIANT_NAME=\"gt_keygen_all_cq_direct_cq\" \
	-DBENCH_VARIANT_GT=1 \
	-ffunction-sections \
	-fdata-sections \
	-Wl,--gc-sections
else ifeq ($(VARIANT),gt_keygen_all_cq_shared_core_direct_cq)
SCHEME_ROOT = $(NTRUPLUS)
SOURCES = $(BENCH_SOURCES) $(GT_KEM_CORE) \
	$(filter-out $(GT_NTT_ASM),$(GT_KEM_SOURCES)) \
	$(GT_KEYGEN_ALL_CQ_SOURCE) $(GT_SHARED_CORE_DIRECT_CQ_SOURCE)
VARIANT_FLAGS = \
	$(GT_PRODUCTION_DEFAULT_FLAGS) \
	$(GT_COMPONENT_FLAGS) \
	-DGT_EXPERIMENT_USE_KEYGEN_ALL_CQ \
	-DGT_EXPERIMENT_USE_KEYGEN_DIRECT_CQ_ENDPOINT \
	-DGT_EXPERIMENT_USE_KEYGEN_SHARED_NTT_CORE \
	-DGT_PRODUCTION_VARIANT_NAME=\"gt_keygen_all_cq_shared_core_direct_cq\" \
	-DBENCH_VARIANT_GT=1 \
	-ffunction-sections \
	-fdata-sections \
	-Wl,--gc-sections
else ifeq ($(VARIANT),kpqc_final)
SCHEME_ROOT = $(KPQC_FINAL_ROOT)
SOURCES = $(BENCH_SOURCES) $(KPQC_KEM_CORE) $(KPQC_KEM_SOURCES)
VARIANT_FLAGS = \
	-DGT_PRODUCTION_VARIANT_NAME=\"kpqc_final\" \
	-DBENCH_VARIANT_GT=0
else
$(error unknown VARIANT=$(VARIANT); use gt_production_default, gt_production_keygen_cq, gt_keygen_all_cq, gt_keygen_all_cq_direct_bpq, gt_keygen_all_cq_direct_cq, gt_keygen_all_cq_shared_core_direct_cq, or kpqc_final)
endif

ifeq ($(USE_SHAKE_ASM),1)
SOURCES += $(SCHEME_ROOT)/CE/fips202.c $(SCHEME_ROOT)/CE/f1600.S
SHAKE_FLAGS = -DSUPPORTS_SHAKE256_ASM
else
SOURCES += $(SCHEME_ROOT)/NO_CE/fips202.c
SHAKE_FLAGS =
endif

BENCH_CFLAGS = \
	-Wall \
	-Wextra \
	-Werror=unused-result \
	-Wpedantic \
	-Wmissing-prototypes \
	-Wshadow \
	-Wpointer-arith \
	-Wredundant-decls \
	-Wno-long-long \
	-Wno-unknown-pragmas \
	-Wno-unused-command-line-argument \
	-Wno-unused-parameter \
	-Wno-unused-const-variable \
	-Wno-unused-function \
	-O3 \
	-fomit-frame-pointer \
	-std=c99 \
	-pedantic \
	-D_GNU_SOURCE \
	-DBENCH_MODE=\"$(BENCH_MODE)\" \
	-DBENCH_NAME=\"$(VARIANT)_$(BENCH_MODE)\" \
	-DBENCH_ENABLE_KEM=1 \
	-DBENCH_ENABLE_INVNTT_STAGES=0 \
	-DNTESTS=$(NTESTS) \
	-DNITERATIONS=$(NITERATIONS) \
	-DNWARMUP=$(NWARMUP) \
	$(VARIANT_FLAGS) \
	$(SHAKE_FLAGS) \
	$(EXTRA_CFLAGS) \
	-Ihal \
	-I$(SCHEME_ROOT) \
	-I$(SCHEME_ROOT)/CE \
	-I$(SCHEME_ROOT)/NO_CE \
	-MMD

ifeq ($(CYCLES),PMU)
BENCH_CFLAGS += -DPMU_CYCLES
else ifeq ($(CYCLES),PERF)
BENCH_CFLAGS += -DPERF_CYCLES -DBENCH_COUNTER_NAME=\"cycles\"
else ifeq ($(CYCLES),INSTRUCTIONS)
BENCH_CFLAGS += -DPERF_INSTRUCTIONS -DBENCH_COUNTER_NAME=\"instructions\"
else ifeq ($(CYCLES),MAC)
BENCH_CFLAGS += -DMAC_CYCLES
endif

.PHONY: all clean check-symbol-closure bench-decap-verify-f1-f2
.PHONY: bench-decap-verify-group-pipeline
.PHONY: bench-decap-verify-group-pipeline-v2
.PHONY: bench-decap-verify-group-pipeline-v3
.PHONY: bench-decap-verify-group-pipeline-v3-slothy
.PHONY: bench-decap-verify-group-pipeline-v3-slothy-compact
.PHONY: bench-keygen-layout-paired
all: $(TARGET)

$(TARGET): $(SOURCES)
	$(CC) $(BENCH_CFLAGS) $(SOURCES) -o $@

check-symbol-closure: $(TARGET)
	python3 $(NTRUPLUS)/scripts/check_gt_production_binary_symbols.py \
		--keygen-layout $(GT_PRODUCTION_KEYGEN_LAYOUT) $(TARGET)

GT_DECAP_VERIFY_F1_F2_TARGET ?= bench-decap-verify-f1-f2
GT_DECAP_VERIFY_F1_F2_SOURCES = \
	bench_decap_verify_compact_speed_pmu.c \
	bench_kem_decap_verify_compact_wrapper.c \
	bench_kem_decap_verify_speed_wrapper.c \
	$(NTRUPLUS)/symmetric.c \
	$(filter-out $(GT_PRODUCTION_DECAP_CANONICAL_POINTWISE_SOURCES), \
		$(GT_KEM_SOURCES)) \
	$(NTRUPLUS)/gt_bench/decap_verify_compact_namespaced.c \
	$(NTRUPLUS)/gt_bench/decap_verify_speed_namespaced.c \
	$(NTRUPLUS)/asm/gt/bench/decap_verify_pointwise_compact_namespaced.S \
	$(NTRUPLUS)/asm/gt/bench/decap_verify_pointwise_speed_namespaced.S \
	$(NTRUPLUS)/NO_CE/fips202.c

bench-decap-verify-f1-f2: $(GT_DECAP_VERIFY_F1_F2_SOURCES)
	$(CC) $(BENCH_CFLAGS) -DNINPUTS=32 -ffunction-sections \
		-fdata-sections $(GT_DECAP_VERIFY_F1_F2_SOURCES) \
		-Wl,--gc-sections -o $(GT_DECAP_VERIFY_F1_F2_TARGET)
	size $(GT_DECAP_VERIFY_F1_F2_TARGET)
	nm -an $(GT_DECAP_VERIFY_F1_F2_TARGET) | \
		grep 'gt_decap_verify_pointwise_'

GT_DECAP_VERIFY_GROUP_PIPELINE_TARGET ?= bench-decap-verify-group-pipeline
GT_DECAP_VERIFY_GROUP_PIPELINE_SOURCES = \
	bench_decap_verify_compact_speed_pmu.c \
	bench_kem_decap_verify_compact_wrapper.c \
	bench_kem_decap_verify_group_pipeline_wrapper.c \
	$(NTRUPLUS)/symmetric.c \
	$(filter-out $(GT_PRODUCTION_DECAP_CANONICAL_POINTWISE_SOURCES), \
		$(GT_KEM_SOURCES)) \
	$(NTRUPLUS)/gt_bench/decap_verify_compact_namespaced.c \
	$(NTRUPLUS)/gt_bench/decap_verify_group_pipeline_namespaced.c \
	$(NTRUPLUS)/asm/gt/bench/decap_verify_pointwise_compact_namespaced.S \
	$(NTRUPLUS)/asm/gt/experiment/decap/verify_pointwise_group_pipeline.S \
	$(NTRUPLUS)/NO_CE/fips202.c

bench-decap-verify-group-pipeline: $(GT_DECAP_VERIFY_GROUP_PIPELINE_SOURCES)
	$(CC) $(BENCH_CFLAGS) -DNINPUTS=32 -ffunction-sections \
		-fdata-sections \
		-DBENCH_VARIANT_B_DEC=bench_crypto_kem_dec_group_pipeline \
		-DBENCH_VARIANT_B_NAME=\"group_pipeline\" \
		-DBENCH_PAIRED_LABEL=\"compact_minus_group_pipeline\" \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_SOURCES) \
		-Wl,--gc-sections -o $(GT_DECAP_VERIFY_GROUP_PIPELINE_TARGET)
	size $(GT_DECAP_VERIFY_GROUP_PIPELINE_TARGET)
	nm -an $(GT_DECAP_VERIFY_GROUP_PIPELINE_TARGET) | \
		grep 'gt_decap_verify_pointwise_'

GT_DECAP_VERIFY_GROUP_PIPELINE_V2_TARGET ?= \
	bench-decap-verify-group-pipeline-v2
GT_DECAP_VERIFY_GROUP_PIPELINE_V2_SOURCES = \
	bench_decap_verify_compact_speed_pmu.c \
	bench_kem_decap_verify_compact_wrapper.c \
	bench_kem_decap_verify_group_pipeline_v2_wrapper.c \
	$(NTRUPLUS)/symmetric.c \
	$(filter-out $(GT_PRODUCTION_DECAP_CANONICAL_POINTWISE_SOURCES), \
		$(GT_KEM_SOURCES)) \
	$(NTRUPLUS)/gt_bench/decap_verify_compact_namespaced.c \
	$(NTRUPLUS)/gt_bench/decap_verify_group_pipeline_v2_namespaced.c \
	$(NTRUPLUS)/asm/gt/bench/decap_verify_pointwise_compact_namespaced.S \
	$(NTRUPLUS)/asm/gt/experiment/decap/verify_pointwise_group_pipeline_v2.S \
	$(NTRUPLUS)/NO_CE/fips202.c

bench-decap-verify-group-pipeline-v2: \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_V2_SOURCES)
	$(CC) $(BENCH_CFLAGS) -DNINPUTS=32 -ffunction-sections \
		-fdata-sections \
		-DBENCH_VARIANT_B_DEC=bench_crypto_kem_dec_group_pipeline_v2 \
		-DBENCH_VARIANT_B_NAME=\"group_pipeline_v2\" \
		-DBENCH_PAIRED_LABEL=\"compact_minus_group_pipeline_v2\" \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_V2_SOURCES) \
		-Wl,--gc-sections \
		-o $(GT_DECAP_VERIFY_GROUP_PIPELINE_V2_TARGET)
	size $(GT_DECAP_VERIFY_GROUP_PIPELINE_V2_TARGET)
	nm -an $(GT_DECAP_VERIFY_GROUP_PIPELINE_V2_TARGET) | \
		grep 'gt_decap_verify_pointwise_'

GT_DECAP_VERIFY_GROUP_PIPELINE_V3_TARGET ?= \
	bench-decap-verify-group-pipeline-v3
GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SOURCES = \
	bench_decap_verify_compact_speed_pmu.c \
	bench_kem_decap_verify_compact_wrapper.c \
	bench_kem_decap_verify_group_pipeline_v3_wrapper.c \
	$(NTRUPLUS)/symmetric.c \
	$(filter-out $(GT_PRODUCTION_DECAP_CANONICAL_POINTWISE_SOURCES), \
		$(GT_KEM_SOURCES)) \
	$(NTRUPLUS)/gt_bench/decap_verify_compact_namespaced.c \
	$(NTRUPLUS)/gt_bench/decap_verify_group_pipeline_v3_namespaced.c \
	$(NTRUPLUS)/asm/gt/bench/decap_verify_pointwise_compact_namespaced.S \
	$(NTRUPLUS)/asm/gt/experiment/decap/verify_pointwise_group_pipeline_v3.S \
	$(NTRUPLUS)/NO_CE/fips202.c

bench-decap-verify-group-pipeline-v3: \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SOURCES)
	$(CC) $(BENCH_CFLAGS) -DNINPUTS=32 -ffunction-sections \
		-fdata-sections \
		-DBENCH_VARIANT_B_DEC=bench_crypto_kem_dec_group_pipeline_v3 \
		-DBENCH_VARIANT_B_NAME=\"group_pipeline_v3\" \
		-DBENCH_PAIRED_LABEL=\"compact_minus_group_pipeline_v3\" \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SOURCES) \
		-Wl,--gc-sections \
		-o $(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_TARGET)
	size $(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_TARGET)
	nm -an $(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_TARGET) | \
		grep 'gt_decap_verify_pointwise_'

GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_TARGET ?= \
	bench-decap-verify-group-pipeline-v3-slothy
GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_SOURCES = \
	bench_decap_verify_compact_speed_pmu.c \
	bench_kem_decap_verify_group_pipeline_v3_wrapper.c \
	bench_kem_decap_verify_group_pipeline_v3_slothy_wrapper.c \
	$(NTRUPLUS)/symmetric.c \
	$(filter-out $(GT_PRODUCTION_DECAP_CANONICAL_POINTWISE_SOURCES), \
		$(GT_KEM_SOURCES)) \
	$(NTRUPLUS)/gt_bench/decap_verify_group_pipeline_v3_namespaced.c \
	$(NTRUPLUS)/gt_bench/decap_verify_group_pipeline_v3_slothy_namespaced.c \
	$(NTRUPLUS)/asm/gt/experiment/decap/verify_pointwise_group_pipeline_v3.S \
	$(NTRUPLUS)/asm/gt/experiment/decap/verify_pointwise_group_pipeline_v3_slothy.S \
	$(NTRUPLUS)/NO_CE/fips202.c

bench-decap-verify-group-pipeline-v3-slothy: \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_SOURCES)
	$(CC) $(BENCH_CFLAGS) -DNINPUTS=32 -ffunction-sections \
		-fdata-sections \
		-DBENCH_VARIANT_A_KEYPAIR=bench_crypto_kem_keypair_group_pipeline_v3 \
		-DBENCH_VARIANT_A_ENC=bench_crypto_kem_enc_group_pipeline_v3 \
		-DBENCH_VARIANT_A_DEC=bench_crypto_kem_dec_group_pipeline_v3 \
		-DBENCH_VARIANT_A_NAME=\"group_pipeline_v3\" \
		-DBENCH_VARIANT_B_DEC=bench_crypto_kem_dec_group_pipeline_v3_slothy \
		-DBENCH_VARIANT_B_NAME=\"group_pipeline_v3_slothy\" \
		-DBENCH_PAIRED_LABEL=\"v3_minus_v3_slothy\" \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_SOURCES) \
		-Wl,--gc-sections \
		-o $(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_TARGET)
	size $(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_TARGET)
	nm -an $(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_TARGET) | \
		grep 'gt_decap_verify_pointwise_group_pipeline_v3'

GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_COMPACT_TARGET ?= \
	bench-decap-verify-group-pipeline-v3-slothy-compact
GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_COMPACT_SOURCES = \
	bench_decap_verify_compact_speed_pmu.c \
	bench_kem_decap_verify_compact_wrapper.c \
	bench_kem_decap_verify_group_pipeline_v3_slothy_wrapper.c \
	$(NTRUPLUS)/symmetric.c \
	$(filter-out $(GT_PRODUCTION_DECAP_CANONICAL_POINTWISE_SOURCES), \
		$(GT_KEM_SOURCES)) \
	$(NTRUPLUS)/gt_bench/decap_verify_compact_namespaced.c \
	$(NTRUPLUS)/gt_bench/decap_verify_group_pipeline_v3_slothy_namespaced.c \
	$(NTRUPLUS)/asm/gt/bench/decap_verify_pointwise_compact_namespaced.S \
	$(NTRUPLUS)/asm/gt/experiment/decap/verify_pointwise_group_pipeline_v3_slothy.S \
	$(NTRUPLUS)/NO_CE/fips202.c

bench-decap-verify-group-pipeline-v3-slothy-compact: \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_COMPACT_SOURCES)
	$(CC) $(BENCH_CFLAGS) -DNINPUTS=32 -ffunction-sections \
		-fdata-sections \
		-DBENCH_VARIANT_B_DEC=bench_crypto_kem_dec_group_pipeline_v3_slothy \
		-DBENCH_VARIANT_B_NAME=\"group_pipeline_v3_slothy\" \
		-DBENCH_PAIRED_LABEL=\"compact_minus_v3_slothy\" \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_COMPACT_SOURCES) \
		-Wl,--gc-sections \
		-o $(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_COMPACT_TARGET)
	size $(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_COMPACT_TARGET)
	nm -an $(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_SLOTHY_COMPACT_TARGET) | \
		grep 'gt_decap_verify_pointwise_'

GT_KEYGEN_LAYOUT_PAIRED_TARGET ?= bench-keygen-layout-paired
GT_KEYGEN_LAYOUT_PAIRED_SOURCES = \
	bench_keygen_layout_paired.c \
	$(NTRUPLUS)/symmetric.c \
	$(GT_PRODUCTION_KEM_SUPPORT_SOURCES) \
	$(GT_PRODUCTION_KEYGEN_CQ_NTT_SOURCES) \
	$(GT_PRODUCTION_KEYGEN_COMMON_SOURCES) \
	$(GT_PRODUCTION_BPQ_CQ_KEYGEN_SOURCES) \
	$(GT_PRODUCTION_KEYGEN_CQ_SOURCES) \
	$(NTRUPLUS)/NO_CE/fips202.c

bench-keygen-layout-paired: $(GT_KEYGEN_LAYOUT_PAIRED_SOURCES)
	$(CC) $(BENCH_CFLAGS) -DNINPUTS=32 -ffunction-sections \
		-fdata-sections $(GT_KEYGEN_LAYOUT_PAIRED_SOURCES) \
		-Wl,--gc-sections -o $(GT_KEYGEN_LAYOUT_PAIRED_TARGET)
	size $(GT_KEYGEN_LAYOUT_PAIRED_TARGET)
	nm -an $(GT_KEYGEN_LAYOUT_PAIRED_TARGET) | \
		grep -E 'keygen_|gt_keygen_poly_ntt_to_cq'

clean:
	-$(RM) $(TARGET) $(TARGET).d $(GT_DECAP_VERIFY_F1_F2_TARGET) \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_TARGET) \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_V2_TARGET) \
		$(GT_DECAP_VERIFY_GROUP_PIPELINE_V3_TARGET) \
		$(GT_KEYGEN_LAYOUT_PAIRED_TARGET) hal/*.d
