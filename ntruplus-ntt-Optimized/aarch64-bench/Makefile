	$(NTRUPLUS)/ntt.c \
	$(GT_SUPPORT_ASM) \
	$(GT_PRODUCTION_NTT_ASM) \
	$(GT_PRODUCTION_NTT32_ASM) \
	$(GT_PRODUCTION_INVNTT_ASM) \
