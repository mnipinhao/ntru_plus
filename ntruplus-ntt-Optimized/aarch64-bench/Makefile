.PHONY: all clean bench-gt bench-kpqc-final bench_gt_kem_stage_pmu bench_gt_nonhash_substage_pmu bench_gt_keygen_component_profile_pmu bench_gt_decap_component_profile_pmu bench_gt_encap_residual_split_pmu bench_gt_kem_component_profile_pmu bench_gt_baseinv_kway_pmu bench_gt_baseinv_hier_k8_diff check_gt_basemul_add_direct32_q31_reducer check_gt_direct32_q31_release_guard check_gt_direct32_q31_release_candidate

TARGET = bench
CC ?= gcc
LD := $(CC)
RM ?= rm -f
PYTHON ?= python3

VARIANT ?= gt_production_no_q31
BENCH_MODE ?= kem_enc
USE_SHAKE_ASM ?= 0
NTESTS ?= 500
NITERATIONS ?= 300
NWARMUP ?= 50
EXTRA_CFLAGS ?=

KEM_MODES = kem_keygen kem_enc kem_dec kem_components
IS_KEM_MODE = $(filter $(BENCH_MODE),$(KEM_MODES))

ifeq ($(IS_KEM_MODE),)
$(error unknown BENCH_MODE=$(BENCH_MODE); production-only bench supports $(KEM_MODES))
endif

NTRUPLUS ?= ntruplus
KPQC_FINAL_ROOT ?= ../../ntruplus-KpqC-Final/Additional_Implementation/aarch64/NTRU+768

GT_PRODUCTION_NTT_ASM ?= $(NTRUPLUS)/asm/gt/poly_ntt.s
