CC := gcc
CFLAGS := -O3 -std=c11 -Wall -Wextra -Werror -Wmissing-prototypes \
	-march=armv8-a+simd -D_DEFAULT_SOURCE -DGT864_P2_EXPORT_INTERNALS \
	-ffunction-sections -fdata-sections
LDFLAGS := -Wl,--gc-sections
BUILD := build
OBJECTS := $(BUILD)/poly.o $(BUILD)/gt864_poly_api.o \
	$(BUILD)/gt864_fr0_basemul.o $(BUILD)/gt864_fr0_basemul_d1.o \
	$(BUILD)/gt864_fr0_inverse_asm_wrapper.o $(BUILD)/ntt.o $(BUILD)/base.o \
	$(BUILD)/pack.o $(BUILD)/gt864_forward_poly_ntt.o \
	$(BUILD)/gt864_forward_six_bank.o $(BUILD)/gt864_top_split.o \
	$(BUILD)/gt864_fr0_inverse9_block.o $(BUILD)/gt864_inverse16_blocks.o

.PHONY: all check clean
all: $(BUILD)/test-components $(BUILD)/bench-components
$(BUILD):
	mkdir -p $@
$(BUILD)/%.o: %.c | $(BUILD)
	$(CC) $(CFLAGS) -I. -c $< -o $@
$(BUILD)/%.o: %.S | $(BUILD)
	$(CC) $(CFLAGS) -I. -c $< -o $@
$(BUILD)/%.o: %.s | $(BUILD)
	$(CC) $(CFLAGS) -I. -c $< -o $@
$(BUILD)/test-components: test_components.c $(OBJECTS)
	$(CC) $(CFLAGS) $(LDFLAGS) -I. -o $@ test_components.c $(OBJECTS)
$(BUILD)/bench-components: bench_components_pmu.c $(OBJECTS)
	$(CC) $(CFLAGS) $(LDFLAGS) -I. -o $@ bench_components_pmu.c $(OBJECTS)
check: $(BUILD)/test-components
	./$(BUILD)/test-components
clean:
	rm -rf $(BUILD)
