CC ?= gcc
CFLAGS ?= -O3 -std=c11 -Wall -Wextra -Werror -march=armv8-a+simd
CFLAGS += -ffixed-v8 -ffixed-v9 -ffixed-v10 -ffixed-v11 -ffixed-v12 \
	-ffixed-v13 -ffixed-v14 -ffixed-v15
DEPS := deps

.PHONY: all clean
all: build/bench-full

build/bench-full: bench_full_pmu.c build/tail_variants.S build/pass2_t0.S \
		build/pass2_t1.S build/pass2_t2.S build/full_t0_wrapper.S \
		build/full_t1_wrapper.S build/full_t2_wrapper.S $(DEPS)/top_split.s
	$(CC) $(CFLAGS) -o $@ $^

clean:
	rm -f build/bench-full
